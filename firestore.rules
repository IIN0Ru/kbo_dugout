rules_version = '2';
// DUGOUT 시연용 Firestore 보안 규칙
// - 모두 익명 로그인. 발표자 화면(#/bench)은 외부에 공개하지 않는 시연용이라 따로 로그인하지 않는다.
// - 그래서 로그인한 사람이면 선수 메시지 발송, 답장 읽기, ❤️·공개 픽이 가능하다.
// - 답장은 자기 이름(uid)으로만 쓰고, 이미 쓴 답장은 ❤️·공개 픽 표시만 바꿀 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 10;
    }

    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update, delete: if false;
    }

    match /replies/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100
        && request.resource.data.heart == false
        && request.resource.data.picked == false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heart', 'picked']);
      allow delete: if false;
    }

    match /picks/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
